# Server
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_DEBUG=true

# Facebook (required)
FB_PAGE_ID=your-facebook-page-id
FB_PAGE_ACCESS_TOKEN=your-facebook-page-access-token
FB_GRAPH_API_VERSION=v21.0

# Database (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=comment_analyzer

# Analyzer
ANALYZER_MODEL_VERSION=analyzer-0.1.0

# Task queue
REDIS_URL=redis://localhost:6379/0

